{% from "icons.njk" import icon, symbols %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#111111">
<title>{{ seoTitle | escape }}</title>
<meta name="description" content="{{ seoDescription | escape }}">
<link rel="canonical" href="{{ seoCanonical | escape }}">
<meta property="og:site_name" content="Yashank Kothari">
<meta property="og:title" content="{{ seoTitle | escape }}">
<meta property="og:description" content="{{ seoDescription | escape }}">
<meta property="og:url" content="{{ seoCanonical | escape }}">
<meta property="og:type" content="{{ 'article' if isBlogPost else 'website' }}">
{% if seoImage %}<meta property="og:image" content="{{ seoImage | escape }}">{% endif %}
<meta name="twitter:card" content="{{ 'summary_large_image' if seoImage else 'summary' }}">
<meta name="author" content="Yashank Kothari">
{% if isBlogPost %}<meta property="article:published_time" content="{{ page.date | isoDate }}">
<meta property="article:modified_time" content="{{ (updated or page.date) | isoDate }}">{% endif %}
{% if page.url.startsWith('/classic/') or page.url.startsWith('/minimal/') %}<meta name="robots" content="noindex,follow">{% endif %}
<script type="application/ld+json">{{ seoSchema | safe }}</script>
<link rel="icon" href="/img/favicon-32.png?v={{ assetV }}" type="image/png" sizes="32x32">
<link rel="icon" href="/img/monogram.svg?v={{ assetV }}" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png?v={{ assetV }}" sizes="180x180">
<link rel="alternate" type="application/rss+xml" title="Yashank Kothari — Writing" href="/feed.xml">
<link rel="stylesheet" href="/css/minimal.css?v={{ assetV }}">
<script>(function(){var theme;try{theme=localStorage.getItem('t')}catch(e){}document.documentElement.dataset.theme=theme||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');document.documentElement.dataset.effects=matchMedia('(prefers-reduced-motion: reduce)').matches?'off':'on'})()</script>
</head>
<body id="top">
{{ symbols() }}
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <a class="signature" href="/" aria-label="Yashank Kothari, home">{% include "monogram.njk" %}</a>
  <nav aria-label="Main navigation">
    <a href="/blog/"{% if section == 'blog' or page.url.startsWith('/blog') %} aria-current="page"{% endif %}>Blog</a>
    <a href="/portfolio/"{% if page.url.startsWith('/portfolio') or page.url.startsWith('/work') %} aria-current="page"{% endif %}>Projects</a>
    <a href="/resume/"{% if page.url == '/resume/' %} aria-current="page"{% endif %}>Experience</a>
    <a href="/now/"{% if page.url == '/now/' %} aria-current="page"{% endif %}>Now</a>
    <span class="nav-divider" aria-hidden="true"></span>
    <a class="icon-link nav-social" href="https://github.com/yashankkothari" aria-label="GitHub" title="GitHub">{{ icon("github") }}</a>
    <a class="icon-link nav-social" href="mailto:kothariyashank@gmail.com" aria-label="Email" title="Email">{{ icon("mail") }}</a>
    <a class="icon-link nav-social" href="/feed.xml" aria-label="RSS feed" title="RSS feed">{{ icon("rss") }}</a>
    <button class="icon-link theme-toggle" id="theme" type="button" aria-label="Switch color theme" title="Switch color theme">{{ icon("sun") }}</button>
  </nav>
</header>
<main id="main" class="page m-{{ page.fileSlug or 'home' }}{% if wide %} page-wide{% endif %}" tabindex="-1">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="footer-nav"><a href="/uses/">Uses</a><a href="/stats/">Stats</a><a href="/resume/">Résumé</a><a href="/classic/">Previous design</a><a href="#" data-terminal-open title="Or press ~">{{ icon("terminal") }} Terminal</a></div>
  <div class="footer-radio"><button type="button" class="radio" data-radio aria-pressed="false" data-src="{{ nowplaying.src }}" data-title="{{ nowplaying.title }}" data-artist="{{ nowplaying.artist }}" aria-label="Play or pause {{ nowplaying.title }} by {{ nowplaying.artist }}"><span class="eq" aria-hidden="true"><i></i><i></i><i></i></span><span class="radio-label">Play</span></button><span>{{ nowplaying.title }} <span class="dim">/ {{ nowplaying.artist }}</span></span></div>
  <div class="footer-meta"><span>© {{ buildYear }} Yashank Kothari</span><span><span data-clock>--:--</span> in Mumbai <span class="live-dot" aria-hidden="true"></span></span></div>
</footer>
<script src="/js/minimal.js?v={{ assetV }}" defer></script>
<script src="/js/radio.js?v={{ assetV }}" defer></script>
<script src="/js/terminal.js?v={{ assetV }}" defer></script>
</body>
</html>
