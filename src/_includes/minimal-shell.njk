<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != "yashank kothari" %}{{ title | lower }} · {% endif %}yashank kothari</title>
<meta name="description" content="{{ description or 'yashank kothari, data engineer in mumbai. pipelines, local llms and small tools.' }}">
<meta property="og:title" content="{{ title or 'yashank kothari' }}">
<meta property="og:description" content="{{ description or 'yashank kothari, data engineer in mumbai. pipelines, local llms and small tools.' }}">
<meta property="og:type" content="website">
<link rel="icon" href="/img/owl.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/minimal.css">
<script>document.documentElement.dataset.theme=localStorage.getItem('t')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark')</script>
</head>
<body id="top">
<main class="m-{{ page.fileSlug or 'home' }}">
  <header>
    {% if navHome %}<h1>yashank kothari</h1>{% else %}<h1><a class="home" href="/">yashank kothari</a></h1>{% endif %}
    <nav>
      <a href="/blog/"{% if section == 'blog' or page.url.startsWith('/blog') %} aria-current="page"{% endif %}>blog</a>
      <a href="/portfolio/"{% if page.url.startsWith('/portfolio') or page.url.startsWith('/work') %} aria-current="page"{% endif %}>projects</a>
      <a href="/resume/"{% if page.url == '/resume/' %} aria-current="page"{% endif %}>résumé</a>
      <a href="mailto:kothariyashank@gmail.com">email</a>
      <a href="https://github.com/yashankkothari">github</a>
      <a href="https://www.linkedin.com/in/yashankkothari/">linkedin</a>
      <button id="theme" aria-label="toggle light and dark mode">◐</button>
    </nav>
  </header>
{{ content | safe }}
  <footer>
    <span>© 2026 yashank kothari · plain html, css and js · <a href="/now/">now</a> · <a href="/uses/">uses</a> · <a href="/stats/">stats</a></span>
    <a href="#top">back to top</a>
  </footer>
</main>
<script src="/js/minimal.js"></script>
</body>
</html>
