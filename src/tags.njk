---
layout: base.njk
pagination:
  data: collections.topics
  size: 1
  alias: tag
permalink: /blog/tags/{{ tag | slugify }}/
eleventyComputed:
  title: "Writing: {{ tag }}"
  description: "Guides, experiments, and essays about {{ tag | replace('-', ' ') }} by Yashank Kothari, a data engineer and software builder in Mumbai."
---
<h1>{{ tag | replace("-", " ") }}</h1>
<p>Guides, experiments, and essays filed under this topic.</p>

<ul class="post-list">
{%- for post in collections[tag] | reverse %}
  <li><time>{{ post.date | readableDate }}</time><a href="{{ post.url }}">{{ post.data.title }}</a></li>
{%- endfor %}
</ul>

<p class="post-back"><a href="/blog/">&larr; all writing</a></p>
