---
layout: minimal.njk
title: Projects
description: "Software, games, and experiments by Yashank Kothari: Savory, Pixonomy, NotesAid, MalNotWare, OncoLytix, TrueHire, and an accessible Aadhaar portal."
wide: true
permalink: "{{ '/portfolio/' if site.design == 'minimal' else '/minimal/portfolio/' }}"
eleventyExcludeFromCollections: true
---
{% from "icons.njk" import icon %}
{% set projectIcons = ["code","bookmark","dice","notes","shield","pulse","check","globe"] %}
<div class="page-heading"><h1 id="projects">Projects</h1><p>Things I’ve made, and a few I’m still figuring out.</p><a class="subtle-link" href="https://github.com/yashankkothari">{{ icon("github") }} All repositories</a></div>
{% set groups = [{title:"Current focus",min:1,max:2},{title:"Tools & experiments",min:3,max:7}] %}
{% for group in groups %}
<section class="project-group">
  <h2>{{ group.title }}</h2>
  <div class="project-grid">
  {% for p in collections.project | sort(false, false, "data.order") %}
  {% if p.data.order >= group.min and p.data.order <= group.max %}
    <article class="project-entry">
      <a class="project-main" href="{{ p.url }}">
        <span class="project-symbol project-color-{{ p.data.order }}">{{ icon(projectIcons[p.data.order]) }}</span>
        <div><h3>{{ p.data.title }} <span class="entry-arrow" aria-hidden="true">↗</span></h3><p>{{ p.data.summary }}</p><span class="project-tech">{{ p.data.tech | join(" · ") }}</span></div>
      </a>
      <div class="project-entry-links"><a href="{{ p.url }}">Story &amp; screenshots</a>{% if p.data.live %}<a href="{{ p.data.live }}">Visit ↗</a>{% endif %}{% if p.data.source %}<a href="{{ p.data.source }}">Source ↗</a>{% endif %}</div>
    </article>
  {% endif %}
  {% endfor %}
  </div>
</section>
{% endfor %}
<section class="repository-section"><h2>More from GitHub</h2><p class="dim">Smaller experiments, side projects, and earlier work.</p><div class="repository-grid">
{% for repo in github.repos %}
<a class="repository" href="{{ repo.url }}"><span>{{ icon("code") }} {{ repo.name }}</span><span class="small dim">{{ repo.description or repo.language or "Open repository" }}</span></a>
{% endfor %}
</div></section>
