---
layout: minimal.njk
title: blog · yashank kothari
description: "practical notes on data pipelines, local llms and my setup."
section: blog
permalink: "{{ '/blog/' if site.design == 'minimal' else '/minimal/blog/' }}"
eleventyExcludeFromCollections: true
---
{%- set posts = collections.post | reverse -%}
  <section>
    <h2>blog</h2>
    <p class="intro">practical notes on data pipelines, local llms and my setup. every post has diagrams and code you can run.</p>
    <div class="filters">
      <button class="on" data-f="all">all <span class="dim">{{ posts | length }}</span></button>
      {%- for f in ["data", "genai", "agents", "linux"] %}
      <button data-f="{{ f }}">{{ f }} <span class="dim">{{ posts | byTopic(f) | length }}</span></button>
      {%- endfor %}
    </div>
    <ul class="posts">
    {%- set last = "" %}
    {%- for post in posts %}
      {%- set m = post.date | monthYear %}
      {%- if m != last %}<li class="month">{{ m }}</li>{% set last = m %}{% endif %}
      {%- set t = post.data.tags | topic %}
      <li class="post" data-tag="{{ t }}"><span class="date dim">{{ post.date | dayNum }}</span><a href="{{ post.url }}">{{ post.data.title | lower }}</a><span class="hl {{ {'genai':'c-blue','agents':'c-pink','data':'c-green','linux':'c-gold'}[t] }} tag">{{ t }}</span></li>
    {%- endfor %}
    </ul>
  </section>
