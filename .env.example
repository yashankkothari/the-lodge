# GitHub API Token (Optional: enables the GitHub contributions section)
GITHUB_TOKEN=

# Discord User ID for the presence widget (Optional: falls back to a default id)
DISCORD_USER_ID=

# PostHog Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Talvess Stats API (Optional: adds live growth to the saved visitor total)
TALVESS_STATS_KEY=
TALVESS_ORIGIN=https://talvess.app

# Google Search Console verification token (Optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
